# Server
NODE_ENV=development
PORT=3001

# Local PostgreSQL 18 (Windows service)
# 1. Ensure the PostgreSQL service is running (services.msc).
# 2. Create the database once, e.g. in psql:
#      CREATE DATABASE roms_dev;
# 3. Replace YOUR_PASSWORD with the password for the postgres user.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/roms_dev

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me-to-a-64-character-random-string-in-production-abc123xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AI (optional — omit the API key to disable AI routes with 503 AI_UNAVAILABLE)
# Default provider is Groq (OpenAI-compatible API, used via the OpenAI SDK).
# Get a key at https://console.groq.com/keys
AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# Defaults when AI_PROVIDER=groq:
#   model:    llama-3.3-70b-versatile
#   base URL: https://api.groq.com/openai/v1
# To switch back to OpenAI, set AI_PROVIDER=openai and OPENAI_API_KEY instead
# (defaults: model gpt-4o-mini, standard OpenAI base URL). No code changes needed.
# OPENAI_API_KEY=sk-...
# Optional overrides (apply to whichever provider is active):
# AI_MODEL=
# AI_BASE_URL=
AI_TIMEOUT_MS=45000
# Max AI calls per user per 10 minutes (default 20)
# AI_RATE_LIMIT_MAX=20

# Client (Vite — must be prefixed with VITE_)
VITE_API_URL=http://localhost:3001/api/v1

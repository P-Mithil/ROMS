# Server
NODE_ENV=development
PORT=3001

# Local PostgreSQL 18 (Windows service)
# 1. Ensure the PostgreSQL service is running (services.msc).
# 2. Create the database once, e.g. in psql:
#      CREATE DATABASE roms_dev;
# 3. Replace YOUR_PASSWORD with the password for the postgres user.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/roms_dev

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me-to-a-64-character-random-string-in-production-abc123xyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Client (Vite — must be prefixed with VITE_)
VITE_API_URL=http://localhost:3001/api/v1
